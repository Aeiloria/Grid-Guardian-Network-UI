# Server-side Gemini API key. Set this in the host environment. Do not commit a value.
GEMINI_API_KEY=

# Required. The server refuses to start when this is missing. Do not commit a value.
JWT_SECRET=

# Server-side map keys. Served only to an authenticated session, never bundled into the client.
GOOGLE_MAPS_API_KEY=
ARCGIS_API_KEY=

# Optional public URL of this app.
APP_URL=
